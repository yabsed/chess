let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
let secrets = Resources.*[ Type == 'AWS::SecretsManager::Secret' ]
let tasks = Resources.*[ Type == 'AWS::ECS::TaskDefinition' ]
let services = Resources.*[ Type == 'AWS::ECS::Service' ]

rule preserve_database when %databases !empty {
    %databases {
        DeletionPolicy == 'Retain'
        UpdateReplacePolicy == 'Retain'
        Properties.StorageEncrypted == true
        Properties.PubliclyAccessible == false
        Properties.DeletionProtection == true
        Properties.BackupRetentionPeriod >= 1
    }
}

rule preserve_secret when %secrets !empty {
    %secrets {
        DeletionPolicy == 'Retain'
        Properties.SecretString !exists
    }
}

rule restrict_container when %tasks !empty {
    %tasks.Properties.ContainerDefinitions.* {
        ReadonlyRootFilesystem == true
        Privileged !exists OR
        Privileged == false
    }
}

rule keep_healthy_tasks when %services !empty {
    %services.Properties.DeploymentConfiguration {
        MinimumHealthyPercent == 100
        DeploymentCircuitBreaker.Enable == true
        DeploymentCircuitBreaker.Rollback == true
    }
}

rule keep_access_keys_out_of_templates {
    Resources.*.Type != 'AWS::IAM::AccessKey'
}

# A foundation update must not be able to rewrite the roles it can pass.
rule restrict_foundation_iam when Resources.FoundationRole exists {
    Resources.FoundationRole.Properties.ManagedPolicyArns !exists
    Resources.FoundationRole.Properties.Policies.*.PolicyDocument.Statement.* {
        Action.* != '*'
        Action.* != 'iam:*'
        Action.* != 'iam:PutRolePolicy'
        Action.* != 'iam:PutUserPolicy'
        Action.* != 'iam:AttachRolePolicy'
        Action.* != 'iam:UpdateAssumeRolePolicy'
    }
}
